# Copy file này thành .env và điền key thật. .env KHÔNG được commit (đã có trong .gitignore).

# Chọn 1 provider LLM (Groq ưu tiên nếu có key):
GROQ_API_KEY=gsk-...
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
TAVILY_API_KEY=tvly-...

# Optional — bật LangSmith tracing để xem từng bước graph chạy (rất hữu ích
# khi debug interview loop hoặc so sánh v8/v9 kiểu bạn đã làm ở Viettel AI Race)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=deep-research-agent
