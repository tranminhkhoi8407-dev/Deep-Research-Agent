# Copy file này thành .env và điền key thật. .env KHÔNG được commit.

# Chọn đúng 1 provider LLM: groq | gemini | openai
LLM_PROVIDER=groq

# Chỉ cần điền key/model của provider đã chọn.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Web/CLI luôn gửi research_depth=quick|standard|deep. LOW_QUOTA_MODE chỉ là
# chế độ dự phòng cho client cũ không gửi research_depth: true => quick.
ENABLE_PROFILE_EXTRACTION=false
LOW_QUOTA_MODE=true

# Bắt buộc cho web search.
TAVILY_API_KEY=

# Optional — bật LangSmith tracing để xem từng bước graph chạy.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent

# Authentication / OAuth
# Tạo chuỗi bí mật riêng, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173

# Nơi lưu tài khoản, vai trò và nhật ký vận hành của Host Console.
AUTH_DATABASE_PATH=data/deep-research.db

# Thư viện học thuật AI (paper, bộ sưu tập và ghi chú riêng theo tài khoản).
PAPER_DATABASE_PATH=data/paper-library.db
# Tùy chọn: email liên hệ thật để Crossref nhận diện ứng dụng khi gọi API.
SCHOLARLY_CONTACT_EMAIL=

# Email được cấp quyền host, ngăn cách bằng dấu phẩy nếu có nhiều người.
# Ví dụ: ADMIN_EMAILS=you@gmail.com,cohost@example.com
ADMIN_EMAILS=

# Development mặc định có tài khoản cục bộ để test. Luôn tắt khi deploy production.
AUTH_DEV_LOGIN=true
AUTH_COOKIE_SECURE=false

# Google OAuth callback: http://127.0.0.1:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth callback: http://127.0.0.1:8000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Research conversations (owner-scoped SQLite, persisted separately from reports).
RESEARCH_CHAT_DATABASE_PATH=data/research-chat.db

# Durable snapshots (giữ tài khoản, reports, avatars khi deploy Render Free).
# Render Free xóa toàn bộ file mỗi lần restart: bật snapshot để API tự tải bản
# mới nhất lúc khởi động và đẩy bản mới mỗi vài phút + khi tắt gracefully.
# Không cấu hình các biến này => chạy local-only như cũ, không ảnh hưởng gì.
#
# Cách 1 (khuyên dùng, không cần thẻ): private GitHub repo.
# - Tạo repo PRIVATE mới (ví dụ: nexora-snapshots), không cần code gì trong đó.
# - GitHub Settings > Developer settings > Personal access tokens >
#   Fine-grained tokens > Generate new token: Repository access = Only select
#   repositories (chọn repo snapshots), Permissions > Contents = Read and write.
# SNAPSHOT_GITHUB_TOKEN=github_pat_...
# SNAPSHOT_GITHUB_REPO=owner/nexora-snapshots
# SNAPSHOT_GITHUB_BRANCH=main
# SNAPSHOT_GITHUB_PATH=snapshots
#
# Cách 2: Cloudflare R2 (cần add payment method mới dùng được).
# R2_BUCKET=tên bucket (ví dụ: nexora-snapshots)
# R2_ACCOUNT_ID=mã account trong URL R2 (xxx.r2.cloudflarestorage.com)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PREFIX=prod
#
# SNAPSHOT_INTERVAL_SECONDS=300
# Kiểm tra kết nối: .venv\Scripts\python -m backend.persist check

# Optional dedicated OpenCode worker. Local helper generates these in
# data/opencode/runtime.env; never use the personal desktop server/auth.
# See docs/research-chat-opencode.md. Leave blank until configured.
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=<independent random secret>
# OPENCODE_GATEWAY_TOKEN=<independent random secret, at least 24 characters>
# OPENCODE_GATEWAY_URL=http://127.0.0.1:8000/internal/opencode/v1
# OPENCODE_READER_URL=http://127.0.0.1:8000/internal/opencode/reader
# OPENCODE_ALLOWED_MODELS=longcat-2.5-preview-free,mimo-v2.6-flash-free
# OPENCODE_PRIVATE_MODELS=
# OpenCode defaults to the SAME provider/model configured above. No Console
# key is required for that selection. Disable explicitly if needed:
# OPENCODE_ENABLE_CONFIGURED_PROVIDER=true
# API/service access for the Nexora server must be explicitly provisioned.
# Desktop Free-tier availability is not entitlement to a public web API.
# OPENCODE_UPSTREAM_API_KEY=<appropriate OpenCode Console API credential>
# Experimental DIRECT Free chat only, off by default. Existing sessions never
# switch transport. New chats use only Muse Contributor Free + native questions;
# historical MiMo/LongCat sessions remain unchanged. Isolated DBs + reviewed guard.
# OPENCODE_DIRECT_ENABLED=false
# OPENCODE_DIRECT_CONTROL_URL=http://127.0.0.1:8000/internal/opencode/direct
