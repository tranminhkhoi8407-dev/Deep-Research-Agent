    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@handlewithcare/prosemirror-inputrules": "^0.1.4",
