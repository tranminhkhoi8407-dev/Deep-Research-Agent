    "test:theme": "node --test tests/themePalette.test.mjs",
    "test:fields": "node --test tests/fieldNavigation.test.mjs tests/workspaceTabs.test.mjs tests/notebookChrome.test.mjs",
    "test:notebook": "node --test tests/notebook.test.mjs",
    "test:notebook-links:browser": "node tests/notebookLinks.browser.mjs",
    "test:notebook-media:browser": "node tests/notebookMedia.browser.mjs",
    "test:notebook-media": "node --test tests/notebookMedia.test.mjs",
    "test:research": "node --test tests/researchForm.test.mjs tests/reportExports.test.mjs tests/researchVisuals.test.mjs tests/researchChat.test.mjs tests/researchNavigation.test.mjs tests/opencodeDirectGuard.test.mjs",
    "test:research:browser": "node tests/researchVisuals.browser.mjs",
