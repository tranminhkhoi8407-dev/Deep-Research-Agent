{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deep-research-agent",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/health"],
  },
}
